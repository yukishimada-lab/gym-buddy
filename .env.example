# Supabase プロジェクトの設定値
# Supabase ダッシュボード → Project Settings → API からコピーしてください。
# ローカル開発ではこのファイルを .env.local にコピーして値を埋めます。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini API キー(食事写真の解析・外食メニュー検索・マイ商品の栄養成分表示の読み取り・目標アドバイスで使用)
# https://aistudio.google.com/apikey で無料発行できます。
# サーバー専用シークレットのため NEXT_PUBLIC_ は絶対に付けないこと。
GEMINI_API_KEY=your-gemini-api-key

# 使用する Gemini のモデル名(任意)。
# 未設定なら lib/gemini.ts の候補(gemini-3.6-flash → gemini-3.5-flash → gemini-2.5-flash)を
# 順に試します。モデルが提供終了になったときは、まず /api/gemini/health で
# 使えるモデルを確認し、必要ならここで固定してください。
# GEMINI_MODEL=gemini-3.6-flash
